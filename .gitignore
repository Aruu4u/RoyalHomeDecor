# =========================================================
#  Royal Home Decor
# =========================================================
#
#  Anything listed here stays on your machine and never
#  reaches GitHub. The secrets section at the top is the
#  important one: those files hold live database and payment
#  credentials.


# ---------------------------------------------------------
#  Secrets  (never commit these)
# ---------------------------------------------------------

.env
.env.*
*.env

# The example files are safe: placeholders only, no real values.
!.env.example

# Saved sign-in payload used for manual API testing. Contains a
# real email and password.
login.json

*.pem
*.key
*.p12
secrets.json
service-account*.json


# ---------------------------------------------------------
#  Dependencies and build output
# ---------------------------------------------------------

# 111 MB, rebuilt by `pip install -r requirements.txt`.
venv/
.venv/
env/

# 126 MB, rebuilt by `npm install`.
node_modules/

dist/
dist-ssr/
build/
*.egg-info/


# ---------------------------------------------------------
#  Caches and generated files
# ---------------------------------------------------------

__pycache__/
*.py[cod]
*$py.class

.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
coverage/

# Regenerated by FastAPI on every start, so it goes stale in git.
openapi.json

*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# ---------------------------------------------------------
#  Local backups  (excluded on purpose)
# ---------------------------------------------------------
#
#  Snapshots taken before large changes. Useful locally,
#  but they would double the repository size and duplicate
#  every file for no benefit.

luxury-furniture-backend-backup-*/
luxury-furniture-frontend-backup/
*-backup/
*-backup-*/
*.zip


# ---------------------------------------------------------
#  Unrelated practice files
# ---------------------------------------------------------
#
#  This repository holds the Royal Home Decor project only.
#  These are leftovers from earlier exercises in the same
#  folder. Anchored with a leading slash so they match only
#  at the repository root.

/ls
/Start.txt
/_pkt_decode.py


# ---------------------------------------------------------
#  Editor and operating system
# ---------------------------------------------------------

.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.DS_Store
Thumbs.db
desktop.ini
