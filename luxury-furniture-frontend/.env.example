# Base URL of the API, including the /api/v1 prefix.
#
#   Local development:  http://127.0.0.1:8000/api/v1
#   Vercel (one project holding both services):  /api/v1
#
# A relative value works on Vercel because the storefront and the API are
# served from the same domain, so the browser resolves it against the
# current origin. Same-origin also means no CORS preflight at all.
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Supabase project, used for sign-in and for image uploads.
# The publishable (anon) key is safe in the browser; the service role key
# is not and must never appear here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
