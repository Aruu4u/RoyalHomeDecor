APP_NAME=Luxury Furniture API
APP_ENV=local
APP_DEBUG=true
API_V1_PREFIX=/api/v1


# ---------------------------------------------------------
#  Database
# ---------------------------------------------------------
#
# Local development and any long-running server (Render, Docker) can use
# the DIRECT Supabase connection on port 5432:
#
#   postgresql+asyncpg://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
#
# Serverless (Vercel) must use the TRANSACTION POOLER on port 6543:
#
#   postgresql+asyncpg://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# The difference matters. Every serverless instance is its own process, so
# each one would open its own connections and quickly exhaust the database's
# limit. The pooler is the only component that sees all of them at once.
DATABASE_URL=postgresql+asyncpg://username:password@host:5432/database
DATABASE_ECHO=false

# Turns off client-side connection pooling and prepared statements, which
# a transaction-mode pooler cannot support.
#
# Leave unset locally. It defaults to true automatically on Vercel, so it
# only needs setting by hand on another serverless host.
# DB_SERVERLESS=true


# ---------------------------------------------------------
#  Supabase
# ---------------------------------------------------------
#
# Only the publishable (anon) key belongs here. It is used to verify the
# tokens the browser sends. The service role key bypasses row-level
# security and must never be put in this file.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_publishable_key


# ---------------------------------------------------------
#  CORS
# ---------------------------------------------------------
#
# Comma-separated list of browser origins allowed to call the API.
#
# Not needed when the storefront and API share a domain, as they do on a
# single Vercel project: same-origin requests send no preflight. Keep the
# local ports so `npm run dev` against a remote API still works.
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173


# ---------------------------------------------------------
#  Payments
# ---------------------------------------------------------

RAZORPAY_KEY_ID=placeholder
RAZORPAY_KEY_SECRET=placeholder
RAZORPAY_WEBHOOK_SECRET=placeholder
RAZORPAY_API_URL=https://api.razorpay.com/v1
